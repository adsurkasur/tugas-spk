relationship rel_fact_waktu
	fromColumn: Fact_Penjualan.DateKey
	toColumn: Dim_Waktu.DateKey

relationship rel_fact_produk
	fromColumn: Fact_Penjualan.ProductKey
	toColumn: Dim_Produk.ProductKey

relationship rel_fact_pelanggan
	fromColumn: Fact_Penjualan.CustomerKey
	toColumn: Dim_Pelanggan.CustomerKey

relationship rel_fact_lahan
	fromColumn: Fact_Penjualan.LahanKey
	toColumn: Dim_Lahan.LahanKey

