table Fact_Penjualan
	lineageTag: fd355eac-bdce-4a19-a623-ecc87aca1e3f

	measure 'Total Pendapatan' = SUM(Fact_Penjualan[TotalPendapatan])
		formatString: "Rp"#,0
		lineageTag: 54a2ba20-bbbc-460d-a595-a466c09637cd

	measure 'Total Volume' = SUM(Fact_Penjualan[Volume])
		formatString: #,0
		lineageTag: 9d754e74-03b6-4bda-82c2-9e29e55953d1

	measure 'Total Transaksi' = COUNTROWS(Fact_Penjualan)
		formatString: #,0
		lineageTag: 0b6bc1e6-fa17-4afd-bb9c-a2d1f6093985

	measure 'Rata-rata Pendapatan per Transaksi' = AVERAGE(Fact_Penjualan[TotalPendapatan])
		formatString: "Rp"#,0
		lineageTag: 4d0c5dcf-12d6-48af-9f0e-3f59ed11e1ec

	measure 'Total Pembeli Unik' = DISTINCTCOUNT(Fact_Penjualan[CustomerKey])
		formatString: #,0
		lineageTag: 6e6a92b6-a87e-41b6-8d50-4fd6e5617b1d

	column TransactionID
		dataType: int64
		summarizeBy: count
		sourceColumn: TransactionID

	column DateKey
		dataType: int64
		summarizeBy: none
		sourceColumn: DateKey

	column ProductKey
		dataType: string
		summarizeBy: none
		sourceColumn: ProductKey

	column CustomerKey
		dataType: string
		summarizeBy: none
		sourceColumn: CustomerKey

	column LahanKey
		dataType: string
		summarizeBy: none
		sourceColumn: LahanKey

	column Volume
		dataType: double
		summarizeBy: sum
		sourceColumn: Volume

	column Satuan
		dataType: string
		summarizeBy: none
		sourceColumn: Satuan

	column HargaSatuan
		dataType: double
		formatString: "Rp"#,0
		summarizeBy: average
		sourceColumn: HargaSatuan

	column TotalPendapatan
		dataType: double
		formatString: "Rp"#,0
		summarizeBy: sum
		sourceColumn: TotalPendapatan

	partition Fact_Penjualan = m
		mode: import
		source =
			let
				Source = Csv.Document(File.Contents("E:/Managed Projects/tugas-spk/data_csv/Fact_Penjualan.csv"),[Delimiter=",", Columns=9, Encoding=65001, QuoteStyle=QuoteStyle.None]),
				#"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				#"Changed Type" = Table.TransformColumnTypes(#"Promoted Headers",{{"TransactionID", Int64.Type}, {"DateKey", Int64.Type}, {"ProductKey", type text}, {"CustomerKey", type text}, {"LahanKey", type text}, {"Volume", type number}, {"Satuan", type text}, {"HargaSatuan", type number}, {"TotalPendapatan", type number}})
			in
				#"Changed Type"
