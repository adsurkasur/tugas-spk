table Fact_Penjualan
	lineageTag: 0ef282ee-d7ca-48c2-968d-11a16e723b2d

	measure 'Total Pendapatan' = SUM(Fact_Penjualan[TotalPendapatan])
		formatString: "Rp"#,0
		lineageTag: 2ac7e00c-77fe-4a4e-bb1e-b0db10abe4d5

	measure 'Total Volume' = SUM(Fact_Penjualan[Volume])
		formatString: #,0
		lineageTag: 6dfa2e63-7885-4297-969b-a27dba1847fe

	measure 'Total Transaksi' = COUNTROWS(Fact_Penjualan)
		formatString: #,0
		lineageTag: 8a1bb66c-0d71-45c4-9a16-f1da760346e7

	measure 'Rata-rata Pendapatan per Transaksi' = AVERAGE(Fact_Penjualan[TotalPendapatan])
		formatString: "Rp"#,0
		lineageTag: 51c77496-ae2f-426b-b85e-62f7a9ba3fee

	measure 'Total Pembeli Unik' = DISTINCTCOUNT(Fact_Penjualan[CustomerKey])
		formatString: #,0
		lineageTag: e7223c7a-3934-4a0b-9929-6a1ada04b342

